# ── EstateStay API environment ──────────────────────────────
# Copy this file as `.env` and adjust values per environment.

# HTTP port the API listens on
PORT=5001

# development | production | test
NODE_ENV=development

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/estatestay
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/estatestay?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/estatestay

# CORS origin of the React app (comma-separated list allowed)
CLIENT_URL=http://localhost:5173

# Authentication — use a long random secret outside local development
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Optional seed-only development Reservations Staff credentials
SEED_RESERVATIONS_STAFF_EMAIL=admin@estatestay.local
SEED_RESERVATIONS_STAFF_PASSWORD=EstateStay-Admin-2026!

# Optional structured enquiry AI
# AI_PROVIDER=gemini | openai | off
AI_PROVIDER=off
AI_API_KEY=
# OpenAI default: gpt-4o-mini. Gemini example: gemini-2.0-flash
AI_MODEL=gpt-4o-mini
