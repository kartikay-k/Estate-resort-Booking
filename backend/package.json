{
  "name": "estatestay-backend",
  "version": "1.0.0",
  "private": true,
  "description": "EstateStay API — Node.js + Express + MongoDB (Mongoose)",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx seed/seed.ts",
    "seed:enquiries": "tsx scripts/seedSampleEnquiries.ts",
    "align:demo-rates": "tsx scripts/alignDemoRoomRates.ts",
    "test:api": "tsx scripts/smoke.ts",
    "migrate:roles": "tsx scripts/migrateReservationsStaff.ts"
  },
  "dependencies": {
    "@types/node": "^26.6.6",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
